  },
  "Export From": {
    "prefix": "exp",
    "body": ["export { ${2} } from '${1}';"],
    "description": "Re-export named export",
  },
  "Export All": {
    "prefix": "exa",
    "body": ["export * from '${1}';"],
    "description": "Export all",
  },
